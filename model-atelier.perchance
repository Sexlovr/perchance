generateHTML = {import:t2i-framework-plugin-v2}
superFetch = {import:super-fetch-plugin}
genStats = {import:generator-stats-plugin-v2}
copyText = {import:copy-text-plugin}
remember = {import:remember-plugin}

$meta
  title = Model Atelier — Provider-neutral Image Generator
  description = A flexible Perchance image workspace with Catbox tools and optional third-party model profiles.
  image = https://user-uploads.perchance.org/file/0adef8a14fc4e89cf7a9c5005d6417f4.jpeg

settings
  pageTitle = Model Atelier
  introMessage = Describe anything you want to create, then generate. No visual style is forced.
  underImagesMessage = <div class="flux-footer-note">Perchance default generation, Catbox gallery tools, and optional third-party model profiles.</div>
  socialFeatures = button
  numImages = [Number(input.numImages)]
  imageButtons
    personality = false
    privateSave = true
  imageOptions
    saveTitle = [input.description]
    prompt = [input.description]
    negativePrompt = [input.negative]
    resolution = [input.shape]
    guidanceScale = [input.Gscale]
    seed = [input.seed]
    onFinish(result) =>
      processGeneration(result)

  userInputs
    description
      label = Prompt
      tip = Write any subject, scene, character, composition, medium, or visual direction you want.
      type = paragraph
      remember = true
      takesUpFullRow = true
      width = min(760px, 100%)
      height = 150px
      enterKeyTriggersGeneration = false
      defaultValue = Describe the image you want to create
    negative
      label = Negative prompt (optional)
      tip = List details you want the model to avoid. Leave blank for full freedom.
      type = text
      remember = true
    shape
      label = Canvas
      type = select
      remember = true
      options
        Portrait = 512x768
        Square = 768x768
        Landscape = 768x512
    numImages
      label = Images to generate
      tip = Enter any positive whole number. Your provider may apply its own request limits.
      type = text
      remember = true
      defaultValue = 1
    Gscale
      label = Guidance (optional)
      type = text
      remember = true
      defaultValue = 7
    seed
      label = Seed (optional)
      tip = Leave blank for a random result. Reuse a seed when you want to explore variations.
      type = text
      remember = true
    catboxAPI
      label = Catbox user hash (optional)
      tip = Used only for authenticated Catbox upload and deletion tools.
      type = text
      remember = true
      takesUpFullRow = true
      foldToggleState = hidden

  galleryOptions
    gallery = true
    showprompt = never
    shownegativePrompt = never
    sort = newest
    adaptiveHeight = true
    remember = true
  showFeedback = false
