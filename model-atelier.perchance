generateHTML = {import:t2i-framework-plugin-v2}
superFetch = {import:super-fetch-plugin}
genStats = {import:generator-stats-plugin-v2}
copyText = {import:copy-text-plugin}
remember = {import:remember-plugin}

$meta
  title = Model Atelier — AI Image Generator
  description = A professional Perchance image generator with style presets, Catbox gallery support, and optional external image models.
  image = https://user-uploads.perchance.org/file/0adef8a14fc4e89cf7a9c5005d6417f4.jpeg

settings
  pageTitle = Model Atelier
  introMessage = Create a polished image from a clear prompt. Choose a style and canvas, then generate.
  underImagesMessage = <div class="flux-footer-note">Perchance default generation, Catbox gallery support, and optional external model configuration.</div>
  socialFeatures = button
  numImages = [Number(input.numImages)]

  imageButtons
    personality = false
    privateSave = true

  imageOptions
    saveTitle = [input.artStyle.getName] — [input.description]
    prompt = [input.artStyle.prompt]
    negativePrompt = [input.artStyle.negative], [input.negative]
    resolution = [input.shape]
    guidanceScale = [input.Gscale]
    seed = [input.seed]
    onFinish(result) =>
      processGeneration(result)

  userInputs
    description
      label = Prompt
      tip = Describe the subject, setting, mood, lighting, composition, and visual style.
      type = paragraph
      remember = true
      takesUpFullRow = true
      width = min(760px, 100%)
      height = 140px
      enterKeyTriggersGeneration = false
      defaultValue = an editorial portrait of an adult creative professional in a sunlit studio, refined composition, natural expression
      examples
        an editorial portrait of an adult creative professional in a sunlit studio, refined composition, natural expression
        a cinematic coastal observatory at blue hour, dramatic clouds, realistic architectural photography
        a whimsical botanical library with floating books, warm light, intricate details, storybook illustration

    negative
      label = Negative prompt
      tip = Optional details to avoid in the generated image.
      type = text
      remember = true
      examples
        blurry, low quality, distorted anatomy, extra fingers, watermark, text artifacts

    catboxAPI
      label = Catbox user hash (optional)
      tip = Used only for Catbox uploads and deletion features. Leave blank if you only want to browse the gallery.
      type = text
      remember = true
      takesUpFullRow = true
      foldToggleState = hidden

    artStyle
      label = Style
      type = select
      remember = true
      options
        Photoreal Studio
          prompt = [input.description], photorealistic studio image, realistic texture, natural color grading, high detail
          negative = cartoon, illustration, 3d render, oversaturated
        Cinematic Frame
          prompt = [input.description], cinematic still, controlled lighting, atmospheric depth, filmic color grade, high detail
          negative = flat lighting, low contrast, text, logo
        Editorial Portrait
          prompt = [input.description], premium editorial photography, art-directed composition, refined styling, soft directional light
          negative = casual snapshot, clutter, harsh flash, watermark
        Anime Illustration
          prompt = [input.description], high-quality anime illustration, expressive character design, clean linework, layered lighting
          negative = photorealism, muddy colors, malformed hands, text
        Concept Art
          prompt = [input.description], professional concept art, imaginative environment design, strong silhouette, detailed materials
          negative = unfinished sketch, flat composition, low detail, watermark

    shape
      label = Canvas
      type = select
      remember = true
      options
        Portrait = 512x768
        Square = 768x768
        Landscape = 768x512

    numImages
      label = Images
      type = select
      remember = true
      options
        default(1) = 1
        2
        3
        4

    Gscale
      label = Guidance
      type = select
      remember = true
      options
        default(7) = 7
        5
        6
        8
        9
        10

    seed
      label = Seed (optional)
      tip = Leave blank for a random result. Reuse a seed to reproduce a result with the same prompt and settings.
      type = text
      remember = true
      examples
        leave blank for a random seed

  galleryOptions
    gallery = true
    showprompt = never
    shownegativePrompt = never
    sort = newest
    adaptiveHeight = true
    remember = true

  showFeedback = false
