generateHTML = {import:t2i-framework-plugin-v2}
commentsPlugin = {import:comments-plugin}
t2iStyles = {import:t2i-styles}

$meta
  title = Prism Forge — Open Image Studio
  description = A clean provider-neutral image workspace with Perchance generation, imported lolmao art styles, Catbox tools, comments, and external model profiles.
  image = https://user-uploads.perchance.org/file/0adef8a14fc4e89cf7a9c5005d6417f4.jpeg

settings
  pageTitle = Prism Forge backend
  introMessage =
  underImagesMessage =
  socialFeatures = enabled
  imageButtons
    personality = false
    privateSave = false
  imageOptions
    prompt = [input.artStyle.prompt]
    negativePrompt = [input.artStyle.negative]
    resolution = [input.shape]
    guidanceScale = [input.guidance]
    seed = [input.seed]
    numImages = [Number(input.numImages)]
  userInputs
    description
      label = Prompt bridge
      type = paragraph
      defaultValue =
      visible() =>
        return true;
    negative
      label = Negative bridge
      type = text
      defaultValue =
      visible() =>
        return true;
    artStyle
      label = Art Style bridge
      type = select
      remember = true
      options
        No style
          prompt = [input.description]
          negative = [input.negative]
          meta:position = 0
        meta:import
          from = {import:lolmao-bro-artstyle}
        meta:import
          from = {import:t2i-styles}
    shape
      label = Shape bridge
      type = select
      options
        Portrait = 512x768
        Square = 768x768
        Landscape = 768x512
    numImages
      label = Image count bridge
      type = text
      defaultValue = 1
      enterKeyTriggersGeneration = true
      remember = true
    guidance
      label = Guidance bridge
      type = text
      defaultValue = 7
    seed
      label = Seed bridge
      type = text
  defaultCommentOptions
    width = 100%
    height = 400
    commentPlaceholderText = Share a prompt, observation, or helpful variation.
    customEmojis = {import:huge-emoji-list}
    submitButtonText = post comment
  commentChannels
    general
      label = General
    chat1
      label = Room 1
    chat2
      label = Room 2
    chat3
      label = Room 3
    prompts
      label = Prompts
      commentPlaceholderText = Share a useful prompt or workflow idea.
      submitButtonText = share prompt
  galleryOptions
    gallery = true
    showprompt = never
    shownegativePrompt = never
    sort = trending
    hideIfScoreIsBelow = -1
    adaptiveHeight = true
    remember = true
  showFeedback = false
