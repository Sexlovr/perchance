generateHTML = {import:t2i-framework-plugin-v2}
superFetch = {import:super-fetch-plugin}
genStats = {import:generator-stats-plugin-v2}
copyText = {import:copy-text-plugin}
remember = {import:remember-plugin}
commentsPlugin = {import:comments-plugin}
selectLeaf = {import:select-leaf-plugin}
fullscreenButton = {import:fullscreen-button-plugin}
aiText = {import:ai-text-plugin}
upload = {import:upload-plugin}
prompt2 = {import:prompt2-plugin}
t2iStyles = {import:t2i-styles}
tabbedCommentsPlugin = {import:tabbed-comments-plugin-v1}
createMediaGalleryPlugin = {import:create-media-gallery-plugin}

$meta
  title = Prism Forge — Provider-neutral Image Generator
  description = A flexible Perchance image workspace with Catbox tools, comments, imported styles, and optional third-party model profiles.
  image = https://user-uploads.perchance.org/file/0adef8a14fc4e89cf7a9c5005d6417f4.jpeg

settings
  pageTitle = Prism Forge
  introMessage = Describe anything you want to create, then generate. Choose a style only when you want one.
  underImagesMessage = <div class="flux-footer-note">Perchance default generation, Catbox gallery tools, comments, and optional third-party model profiles.</div>
  socialFeatures = enabled
  numImages = [Number(input.numImages)]
  imageButtons
    personality = false
    privateSave = true
  imageOptions
    saveTitle = [input.artStyle.getName] — [input.description]
    prompt = [input.artStyle.prompt]
    negativePrompt = [input.negative]
    resolution = [input.shape]
    guidanceScale = [input.Gscale]
    seed = [input.seed]
    onFinish(result) =>
      processGeneration(result)

  userInputs
    scratchpad
      label = Prompt variables
      tip = Keep reusable prompt variables here, for example ANIMAL = {dog|cat|fox}.
      type = paragraph
      remember = true
      parseVariables = true
      useVariables = true
      width = min(760px, 100%)
      height = 110px
      takesUpFullRow = true
      foldToggleState = hidden
      visible() =>
        return Number(localStorage.generateClickCount) > 1;
    notes
      label = Notes
      tip = Keep planning notes here without sending them to the model.
      type = paragraph
      remember = true
      width = min(760px, 100%)
      height = 90px
      takesUpFullRow = true
      foldToggleState = hidden
    description
      label = Prompt
      tip = Write any subject, scene, character, composition, medium, or visual direction you want.
      type = paragraph
      remember = true
      takesUpFullRow = true
      width = min(760px, 100%)
      height = 150px
      enterKeyTriggersGeneration = false
      useVariables = true
      modifiers = [input.artStyle?.modifiers || null]
      defaultValue = Describe the image you want to create
      examples
        a quiet observatory above a cloud sea at blue hour, precise architecture, soft window light
        an expressive character portrait in an unexpected environment, strong silhouette, clear materials
        an impossible machine built from paper, glass, and brass, photographed like a museum object
    negative
      label = Negative prompt (optional)
      tip = List details you want the model to avoid. Leave blank for full freedom.
      type = text
      remember = true
      useVariables = true
    artStyle
      label = Optional style
      type = select
      remember = true
      options
        No style
          prompt = [input.description]
          negative = [input.negative]
          meta:position = 0
        meta:import
          from = {import:t2i-styles}
    shape
      label = Canvas
      type = select
      remember = true
      options
        Portrait = 512x768
        Square = 768x768
        Landscape = 768x512
    numImages
      label = Images to generate
      tip = Enter any positive whole number. Your provider may apply its own request limits.
      type = text
      remember = true
      defaultValue = 1
    Gscale
      label = Guidance (optional)
      type = text
      remember = true
      defaultValue = 7
    seed
      label = Seed (optional)
      tip = Leave blank for a random result. Reuse a seed when you want to explore variations.
      type = text
      remember = true
    catboxAPI
      label = Catbox user hash (optional)
      tip = Used only for authenticated Catbox upload and deletion tools.
      type = text
      remember = true
      takesUpFullRow = true
      foldToggleState = hidden

  defaultCommentOptions
    width = 100%
    height = 400
    commentPlaceholderText = Share a prompt, observation, or helpful variation.
    customEmojis = {import:huge-emoji-list}
    submitButtonText = post comment
  commentChannels
    general
      label = General
    prompts
      label = Prompts
      commentPlaceholderText = Share a useful prompt or workflow idea.
      submitButtonText = share prompt

  galleryOptions
    gallery = true
    showprompt = never
    shownegativePrompt = never
    sort = newest
    adaptiveHeight = true
    remember = true
  showFeedback = false
